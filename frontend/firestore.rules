rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: users
    // Fields: email (string), role (string: admin, staff, user), name (string), photoURL (string)
    //
    // Collection: provinces, cities, destinations, packages, cars, blog
    // (Publicly readable, admin/staff writable)
    //
    // Collection: bookings
    // (Owner readable/writable, admin/staff readable/writable)
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email == "ridhorobbipasi@gmail.com" && request.auth.token.email_verified == true));
    }

    function isStaff() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff' || isAdmin());
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.email is string && data.role in ['admin', 'staff', 'user'];
    }

    function isValidBooking(data) {
      return data.userId == request.auth.uid && data.type in ['package', 'car', 'custom'] && data.status in ['pending', 'confirmed', 'cancelled'];
    }

    // Rules
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(userId) && isValidUser(request.resource.data) && request.resource.data.role == 'user';
      allow update: if isAdmin() || (isOwner(userId) && request.resource.data.role == resource.data.role);
    }

    match /provinces/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /cities/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /destinations/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /packages/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /cars/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /blog/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /bookings/{id} {
      allow read: if isStaff() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && isValidBooking(request.resource.data);
      allow update: if isStaff() || (isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId);
      allow delete: if isAdmin();
    }
  }
}
